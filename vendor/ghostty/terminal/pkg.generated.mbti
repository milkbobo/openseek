pub fn TertiaryDeviceAttributes::to_repr(Self) -> @debug.Repr
pub fn TertiaryDeviceAttributes::unit_id(Self) -> UInt

// Type aliases
pub type CellCountInt = UInt16

// Traits
pub(open) trait StreamHandler {
  fn vt(Self, StreamAction) -> Unit
  fn print(Self, UInt) -> Unit
  fn deinit(Self) -> Unit
}
